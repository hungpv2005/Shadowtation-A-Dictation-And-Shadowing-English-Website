# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit file ".env".

# ===== Chung =====
NODE_ENV=development
APP_PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# ===== PostgreSQL 15 =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shadowtation

# ===== Redis 7 (BullMQ) =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===== Dictation AI Worker =====
# Set the same value in ai-worker/.env
INTERNAL_API_KEY=replace-with-a-long-random-secret
AI_WORKER_URL=http://localhost:8000

# ===== Lưu trữ file (AWS S3 hoặc MinIO khi dev) =====
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ===== Azure Speech (Pronunciation Assessment) =====
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ===== Cổng thanh toán VNPAY (sandbox) =====
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/subscription/success

# ===== Stripe (làm sau) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Google OAuth 2.0 =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

